{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dart",
			"command": "dart",
			"args": [
				"run",
				"build_runner",
				"watch",
				"--workspace",
			],
			"problemMatcher": [
				"$dart-build_runner"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"label": "dart: dart run build_runner watch",
			"runOptions": {
				"runOn": "folderOpen"
			}
		}
	]
}
